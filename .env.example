# OpenRouter configuration for the backend only.
# Never expose the API key to the frontend, Android app, or APK.
# Set these in the runtime environment for the backend server.
#
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=https://soberwatch.app
# OPENROUTER_APP_NAME=SoberWatch
#
# Firebase Admin is initialized via service account or application default credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_WEB_API_KEY must be set for auth.
