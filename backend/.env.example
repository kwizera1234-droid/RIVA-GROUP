# OpenRouter configuration for the backend only.
# Never expose the API key to the frontend, Android app, or APK.
# Set these in the runtime environment for the backend server.
#
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=https://soberwatch.app
# OPENROUTER_APP_NAME=SoberWatch
#
# Firebase Admin is initialized via service account or application default credentials.
# FIREBASE_SERVICE_ACCOUNT_JSON or FIREBASE_WEB_API_KEY must be set for auth.
#
# Vonage Voice (zero-touch emergency calling via POST /api/emergency/call).
# The mobile app never dials with an Intent; Vonage places the PSTN call.
# VONAGE_APPLICATION_ID=your-vonage-application-id
# VONAGE_FROM_NUMBER=+15551234567   (must be Vonage-owned and voice-enabled, E.164)
# Private key resolution order (first match wins):
# VONAGE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."   (inline PEM, \n escapes OK)
# VONAGE_PRIVATE_KEY_PATH=/secure/path/private.key
# ...otherwise ./private.key next to vonage-voice-service.js is used.
# NOTE: VONAGE_API_KEY / VONAGE_API_SECRET are NOT used by voice calls (JWT app auth).

# ============================================
# EMAIL CONFIGURATION (Nodemailer/SMTP)
# ============================================
# Used by the Forgot Password OTP system to send verification codes.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@soberwatch.io
# SMTP_PASS=your-smtp-password-here
# SMTP_SECURE=false
# EMAIL_FROM=noreply@soberwatch.io
# EMAIL_FROM_NAME=SoberWatch

# ============================================
# OTP CONFIGURATION
# ============================================
# OTP expiration in minutes (default: 10)
# OTP_EXPIRATION_MINUTES=10
# Pepper for OTP hashing (must be kept secret)
# OTP_PEPPER=change-this-to-a-secure-random-secret
# Reset token expiration in minutes (default: 15)
# RESET_TOKEN_EXPIRATION_MINUTES=15

# ============================================
# APP URLS
# ============================================
# Frontend URL (for redirect links)
# FRONTEND_URL=https://soberwatch-newversion.onrender.com
# Backend URL
# BACKEND_URL=https://soberwatch-backend.onrender.com
